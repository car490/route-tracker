#cloud-config
# Ubuntu Server autoinstall — Bus Controller (MeLE Quieter4C, see
# docs/CONTROLLER-REDESIGN.md). Produces a headless, SSH-reachable box on
# first boot: no monitor/keyboard needed at any point.
#
# This is a TEMPLATE. Copy it to user-data.local (gitignored — it will hold
# a real SSH key and a real password hash) and fill in the placeholders
# below before building the install USB. See ../DEPLOY.md "0. First boot —
# flashing the OS" for the full procedure.
autoinstall:
  version: 1
  locale: en_GB.UTF-8
  keyboard:
    layout: gb
  identity:
    hostname: coachmate-controller
    username: pi
    # Generate with: openssl passwd -6 '<some password>'
    # Console/password login is disabled below (ssh.allow-pw: false) — this
    # hash only matters if you ever attach a monitor+keyboard directly.
    password: "REPLACE_WITH_SHA512_HASH"
  ssh:
    install-server: true
    allow-pw: false
    authorized-keys:
      - "REPLACE_WITH_YOUR_SSH_PUBLIC_KEY"
  network:
    version: 2
    ethernets:
      any-ethernet:
        match:
          name: "en*"
        dhcp4: true
  storage:
    layout:
      name: direct
  packages:
    - git
    - mpg123
    - curl
    - build-essential
  updates: security
  late-commands:
    # Appliance box, single operator user — passwordless sudo over SSH is a
    # deliberate convenience call here, not a shared multi-user server.
    - "echo 'pi ALL=(ALL) NOPASSWD:ALL' > /target/etc/sudoers.d/90-pi-nopasswd"
    - "chmod 440 /target/etc/sudoers.d/90-pi-nopasswd"
