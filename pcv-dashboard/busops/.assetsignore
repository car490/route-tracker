# busops/ is the wrangler.jsonc assets directory, but only driver/ (minus
# driver/cab-device/), announce/ (minus announce/mele-server/), shared/, and
# service-worker.js are the actual deployed app. Everything below is
# dev/tooling/other-hardware content that must not be served publicly on
# driver.coachmate.uk. wrangler deploy reads from local disk (not git), so
# gitignored dirs like node_modules/ need to be listed here too or they'd
# still get swept into the deploy.
announce/mele-server/
driver/cab-device/
tests/
node_modules/
.wrangler/
package.json
package-lock.json
babel.config.cjs
jest.config.cjs
vitest.config.js
server.js
wrangler.jsonc
.env
.env.*
