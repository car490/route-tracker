supabase/.temp/

# Test tooling deps (root PWA is otherwise zero-dependency at runtime —
# node_modules here is dev-only, for jest/babel)
node_modules/

# GraphHopper — large binary files, not committed
graphhopper/*.osm.pbf
graphhopper/*.osm.pbf.gz
graphhopper/gh-graph-cache/
graphhopper/graphhopper-*.jar

# SSH keypairs — never commit private keys
id_*
*.pem
sshcoachmate*

# pi-server's schedule cache is written at runtime (sync-schedule.mjs) —
# per-vehicle data, not source
pi-server/schedule-cache.json
pi-server/schedule-cache.json.tmp

# Temporary-Pi startup script holds a real DRIVER_PUSH_TOKEN once filled
# in — never commit it. Copy start-temp-pi.example.ps1 to this name.
pi-server/start-temp-pi.local.ps1

# Controller autoinstall config holds a real SSH public key + password
# hash once filled in — never commit it. Copy user-data.example to this
# name (see pi-server/DEPLOY.md "0. First boot").
pi-server/autoinstall/user-data.local

# Idle-screen operator logo — placed at commissioning time (per Controller
# device, downloaded from that operator's own Supabase Storage bucket, see
# pi-server/DEPLOY.md "Idle screen branding"), not source.
branding-logo.png
