# Repo root is the wrangler.jsonc assets directory, but only index.html,
# onboard.html, manifest.json, service-worker.js, style.css, onboard.css,
# icons/, lib/, audio/, and src/ are the actual driver PWA. Everything below
# is dev/tooling/other-project content that must not be served publicly on
# driver.coachmate.uk. wrangler deploy reads from local disk (not git), so
# gitignored dirs like node_modules/ need to be listed here too or they'd
# still get swept into the deploy.
dashboard/
supabase/
scripts/
tests/
pi-server/
wifi-direct-poc/
docs/
graphhopper/
node_modules/
.git/
.github/
.claude/
